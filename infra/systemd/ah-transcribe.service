[Unit]
Description=Municipal hub meeting-recording transcribe + summarize worker
After=network-online.target ah-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atlantic-highlands/api
# Paths and the env file keep the original deployment's names
# (/opt/atlantic-highlands); adjust them when installing for another town.
# Inherit ah-api's env (DATABASE_URL, AWS creds, ANTHROPIC_API_KEY, etc.).
# The scraper proxy vars are not needed here — the worker reads files from
# S3, it doesn't scrape the town site.
EnvironmentFile=-/etc/atlantic-highlands.env
# Which municipalities/<slug>/ profile this deployment serves.
Environment=MUNICIPALITY=atlantic-highlands-nj
# Pin Whisper to a writable cache dir under our app root rather than $HOME,
# which is /root and may be ephemeral on snapshot rotation.
Environment="HF_HOME=/opt/atlantic-highlands/.cache/huggingface"
# small.en + beam 5 + vocabulary prompt (see services/transcription_service.py).
# ~1.4GB peak RSS; a 2-hour meeting takes ~25 min on 2 vCPUs at full speed.
Environment="WHISPER_MODEL=small.en"

ExecStart=/opt/atlantic-highlands/api/venv/bin/python -m scripts.transcribe_pending

# The script checks its 90-min budget only between steps, so one long
# transcription can run past it. 4h covers a 3-hour meeting even when a t3
# instance is throttled to baseline CPU. systemd will SIGTERM then SIGKILL.
TimeoutStartSec=14400

# Be nice — transcription is CPU-bound and would otherwise starve ah-api
# (which serves the UI). nice 10 + best-effort idle io class keeps the
# user-facing API responsive.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Don't crash the timer if a tick errors. The script's own try/except
# already moves docs into *_failed states for individual failures; we just
# don't want systemd to give up scheduling future ticks.
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal
